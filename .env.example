# Copy to .env and fill in. Use a replica and a SELECT-only database user.
HOSXP_HOST=127.0.0.1
HOSXP_PORT=3306
HOSXP_USER=
HOSXP_PASSWORD=
HOSXP_DB=hos
RCM_DB=rcm

# Hospital
HCODE=
HNAME=
# Comma-separated main-contract hospital codes
HOSP_MAIN=
# สิทธิ HOSxP ของทันตกรรมประกันสังคม (คั่นด้วย ,)
DENTAL_PTTYPES=29
# สิทธิ HOSxP ของประกันสังคมกรณีทุพพลภาพ (คั่นด้วย ,)
DISABLED_PTTYPES=33
# สิทธิ HOSxP ที่ใช้ Approve Code กรุงไทย (เบิกจ่ายตรงข้าราชการ) แทน ClaimCode ใน INS.PERMITNO (คั่นด้วย ,)
OFC_APPROVE_PTTYPES=21
# PPFS 27) ยาเสริมธาตุเหล็กเด็ก: icode ค่าบริการ 6–12 เดือน / 2–5 ปี และรหัส ADP ตามชนิดยาที่จ่าย (ยาน้ำ / ยาเม็ด)
PPFS_IRON_CHILD_ICODES=3004084
PPFS_IRON_CHILD2_ICODES=3004023
PPFS_IRON_SYRUP_ADP=689697
PPFS_IRON_TABLET_ADP=776508
# PPFS 26) คัดกรองโลหิตจางเด็ก Hb/Hct: รหัส ADP ที่ส่ง (ใช้ 10000 ตาม HOSxP) และ icode ค่าบริการ 6–12 เดือน / 3–5 ปี
PPFS_ANEMIA_CHILD_ADP=10000
PPFS_ANEMIA_CHILD_ICODES=3003783
PPFS_ANEMIA_CHILD2_ICODES=3004022

# Used when a visit has no valid doctor licence or drug usage
DEFAULT_DOCTOR=
DEFAULT_USAGE_CODE=0201
DEFAULT_USAGE_NAME=วิธีใช้ตามแพทย์สั่ง

STATION=01
# true = InvNo is the VN (old program default)
USE_VN_AS_INVNO=true
# true = send only the principal diagnosis
PDX_ONLY=false

# Web port (https://localhost:<PORT>)
PORT=5180

# Login
LOGIN_REQUIRED=true
# เข้าสู่ระบบด้วยบัญชี HOSxP (ชื่อผู้ใช้/รหัสผ่าน) ปิดไว้ ใช้ MOPH ID อย่างเดียว ตั้ง true เพื่อเปิดกลับ
LOGIN_HOSXP=false
SESSION_HOURS=8
# Optional: only these HOSxP opduser.groupname values may log in (comma-separated). Empty = all active users.
LOGIN_GROUPS=

# MOPH ID (moph.id.th Health ID + Provider ID). Leave empty to hide the button.
MOPH_HEALTH_ID_CLIENT=
MOPH_HEALTH_ID_SECRET=
MOPH_PROVIDER_ID_CLIENT=
MOPH_PROVIDER_ID_SECRET=
# Must match the redirect URL registered with MOPH exactly. Several addresses (LAN IP + public domain):
# list them comma-separated, register every one with MOPH; each login returns to the address it started on.
# e.g. https://192.168.80.88:5180/auth/moph/callback,https://claim.example.org/auth/moph/callback
MOPH_REDIRECT_URI=http://localhost:5180/auth/moph/callback
# Hospitals whose staff may log in (comma-separated). Empty = HCODE only.
MOPH_ALLOWED_HCODES=
# Client name sent to moph.id.th / provider.id.th
MOPH_USER_AGENT=EMR

# Network: HOST=0.0.0.0 lets other computers connect (needs HTTPS, see make_cert.py).
# ALLOWED_HOSTS = names/IPs people type in the browser, e.g. 192.168.80.88
HOST=127.0.0.1
ALLOWED_HOSTS=

# Financial Data Hub (ส่ง 18 แฟ้มเข้า FDH จากหน้า 18 แฟ้ม). Leave empty to disable the FDH buttons.
FDH_USER=
FDH_PASSWORD=
# Token service (the old program used fdh.moph.go.th for both UAT and production)
FDH_TOKEN_URL=https://fdh.moph.go.th

# New e-Claim API (ส่ง 16 แฟ้มเข้า New e-Claim จากหน้า 18 แฟ้ม): the e-Claim login. Leave empty to disable.
NHSO_USER=
NHSO_PASSWORD=
# ดึง REP e-Claim อัตโนมัติ (หน้า REP / STM): ใช้ NHSO_USER / NHSO_PASSWORD ข้างบน + secret ของ TOTP
# (ตัวอักษรที่ได้ตอนตั้ง Authenticator ที่ iam.nhso.go.th กด "Unable to scan?") ใส่ ECLAIM_USER / ECLAIM_PASSWORD ถ้าใช้บัญชีอื่น
ECLAIM_TOTP_SECRET=

# ดึง REP อัตโนมัติทุกวัน (e-Claim ทุกสิทธิย้อนหลัง AUTO_PULL_MONTHS เดือน + Seamless for DMIS ปีงบปัจจุบัน) เวลา HH:MM ว่าง = ปิด
# เปิดที่ server เครื่องเดียว (ถ้าเปิดหลายเครื่องจะ login NHSO ซ้อนกัน)
AUTO_PULL_TIME=
AUTO_PULL_MONTHS=2
# ส่งสรุปทาง LINE Messaging API (LINE Notify ปิดแล้ว): channel access token (long-lived) ของ LINE Official Account
LINE_CHANNEL_TOKEN=
# User ID ผู้รับ (U + 32 ตัว ไม่ใช่ LINE ID) ว่าง = broadcast ถึงทุกคนที่เพิ่มบัญชีเป็นเพื่อน
LINE_TO=
# หรือส่งเข้ากลุ่ม LINE ผ่าน MOPH Alert (ใช้แทน LINE_CHANNEL_TOKEN เมื่อตั้งครบสองค่า) Client ID / Secret ของกลุ่มนั้น
MOPH_ALERT_CLIENT_KEY=
MOPH_ALERT_SECRET_KEY=

# AIPN web (cs8.chi.or.th/aipnupload, สกส.) ดึง REP RP1 + Statement AIPN รหัส รพ. ใช้ HCODE (หรือ AIPN_HCODE)
AIPN_USER=
AIPN_PASSWORD=

# MMS ประกันสังคม (mms.sso.go.th) ดึงรายงาน REP (ส่งเบิก) / STM (การจ่าย) ทันตกรรม ผู้ทุพพลภาพ ฉุกเฉิน 72 ชม. ทีละเดือน ใช้เบราว์เซอร์เบื้องหลัง:
# pip install playwright แล้ว playwright install --with-deps chromium  (รหัส รพ. 9 หลัก ได้จาก HCODE เช่น 10866 -> 001086600)
MMS_USER=
MMS_PASSWORD=
# MMS_HOSP_CODE=
