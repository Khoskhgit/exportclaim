# Copy to .env and fill in. Use a replica and a SELECT-only database user.
HOSXP_HOST=127.0.0.1
HOSXP_PORT=3306
HOSXP_USER=
HOSXP_PASSWORD=
HOSXP_DB=hos
RCM_DB=rcm

# Hospital
HCODE=
HNAME=
# Comma-separated main-contract hospital codes
HOSP_MAIN=

# Used when a visit has no valid doctor licence or drug usage
DEFAULT_DOCTOR=
DEFAULT_USAGE_CODE=0201
DEFAULT_USAGE_NAME=วิธีใช้ตามแพทย์สั่ง

STATION=01
# true = InvNo is the VN (old program default)
USE_VN_AS_INVNO=true
# true = send only the principal diagnosis
PDX_ONLY=false

# Web port (https://localhost:<PORT>)
PORT=5180

# Login
LOGIN_REQUIRED=true
SESSION_HOURS=8
# Optional: only these HOSxP opduser.groupname values may log in (comma-separated). Empty = all active users.
LOGIN_GROUPS=

# MOPH ID (moph.id.th Health ID + Provider ID). Leave empty to hide the button.
MOPH_HEALTH_ID_CLIENT=
MOPH_HEALTH_ID_SECRET=
MOPH_PROVIDER_ID_CLIENT=
MOPH_PROVIDER_ID_SECRET=
# Must match the redirect URL registered with MOPH exactly
MOPH_REDIRECT_URI=http://localhost:5180/auth/moph/callback
# Hospitals whose staff may log in (comma-separated). Empty = HCODE only.
MOPH_ALLOWED_HCODES=
# Client name sent to moph.id.th / provider.id.th
MOPH_USER_AGENT=EMR
